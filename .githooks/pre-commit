#!/bin/sh
# 提交闸门：只扫暂存区（毫秒级，不拖慢每次 commit）。
#
# 为什么要有它：`.gitignore` 只能拦住"已知的"文件名，拦不住"把密钥粘进一个正常文件"
# 这类事故——本项目的私有仓就真的发生过硬编码凭据进库、8/8 个提交全带它。
#
# 启用（每个克隆做一次）：git config core.hooksPath .githooks
#
# 【为什么不用 `command -v python3` 就完事】Windows 上它常命中
# `AppData/Local/Microsoft/WindowsApps/python3`——那是 Microsoft Store 的**假壳**，
# 存在、可执行、但一跑就以退出码 49 静默失败。于是钩子看起来"拦住了提交"，实际
# 闸门一次都没跑过。必须**真的执行一次**才算找到解释器（见 find_python）。
#
# 【为什么找不到解释器要 fail-closed】这是安全闸门，静默放行等于没有。真要在没装
# Python 的机器上提交，请显式 `git commit --no-verify`——让它留下痕迹，而不是自动失效。
set -u

# ── 硬保险：本地 agent 规范永远不得入库 ──────────────────────────────────
# AGENTS.md 是本机开发规范（含内部决策与战术），`.gitignore` 已经排除它，但
# `.gitignore` 可以被删除、被 `git add -f` 绕过、也会在别人的克隆里不生效——
# 而这个文件一旦进了历史就只能靠重写历史收拾（已经发生过一次）。
# 所以这里再挡一道，且**不依赖 Python**：它在脱敏闸门之前、用 git 自身完成。
# 同一个文件也在 .gitignore 里列着，两处都留是刻意的（一处是约定，一处是强制）。
STAGED_LIST=$(mktemp 2>/dev/null || echo "/tmp/caddiff-staged.$$")
if ! git diff --cached --name-only --diff-filter=ACM > "$STAGED_LIST" 2>/dev/null; then
    echo "✖ 无法读取暂存区文件列表（git diff 失败）——拒绝提交（fail-closed）。" >&2
    rm -f "$STAGED_LIST"
    exit 1
fi
if grep -qE '(^|/)AGENTS\.md$|^_internal/|^\.intent/' "$STAGED_LIST"; then
    echo "✖ 拒绝提交：暂存区里有本机/内部文件（AGENTS.md、_internal/ 或 .intent/）。" >&2
    echo "  它们属于本机开发资料，不属于公开仓库（见 .gitignore）。" >&2
    echo "  从暂存区移除：git restore --staged AGENTS.md _internal .intent" >&2
    rm -f "$STAGED_LIST"
    exit 1
fi
rm -f "$STAGED_LIST"

find_python() {
    for candidate in python3 python py; do
        if command -v "$candidate" >/dev/null 2>&1 &&
           "$candidate" -c "pass" >/dev/null 2>&1; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

PY=$(find_python) || {
    echo "✖ 脱敏闸门无法运行：找不到可用的 Python 解释器。" >&2
    echo "  装一个 Python，或用 'git commit --no-verify' 显式跳过（CI 仍会检查）。" >&2
    exit 1
}

exec "$PY" tools/scan_sensitive.py --staged --quiet
